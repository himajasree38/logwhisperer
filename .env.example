# AkashML (AI model)
AKASHML_API_KEY=
AKASHML_BASE_URL=https://api.akashml.com/v1
AKASHML_MODEL=moonshotai/Kimi-K3

# ClickHouse (admin user: data loading only)
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# ClickHouse (read-only user: used by the agents)
CLICKHOUSE_RO_USER=
CLICKHOUSE_RO_PASSWORD=

# Guild.ai (agent hosting and audit log)
GUILD_TRIGGER_URL=
GUILD_AGENT_ID=
GUILD_API_KEY=

# Which table the agents query. Defaults to auth_logs (one day).
# auth_logs_v2 holds the first 16 days, loaded by scripts/load_days.py.
AUTH_TABLE=auth_logs

# Public demo protection (all optional)
# APP_PASSCODE locks /ask, /investigate and /scan to people who have the code.
APP_PASSCODE=
RATE_LIMIT_PER_HOUR=40
RATE_LIMIT_PER_DAY=1500
